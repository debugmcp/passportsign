{
  "name": "@passportsign/web",
  "version": "0.1.0",
  "private": true,
  "description": "passportsign hosted surface: Cloudflare Worker serving live-state badges (/badge/<user>.svg) and the verify page, backed entirely by the public Sigstore Rekor log and user-published passportsign-index.json files. No database.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:app": "vite --config vite.app.config.ts",
    "build": "vite build --config vite.app.config.ts",
    "deploy": "pnpm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.app.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@passportsign/core": "workspace:*",
    "@zkpassport/sdk": "0.15.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250528.0",
    "@types/qrcode": "^1.5.6",
    "vite": "^8.0.16",
    "wrangler": "^4.0.0"
  }
}
